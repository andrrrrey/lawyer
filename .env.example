# ============================================================================
#  Lawyer — переменные окружения. Скопируйте в .env и заполните.
#  .env в репозиторий НЕ коммитится (см. .gitignore). Все секреты — только здесь.
#  Подробно о том, где взять каждый ключ — docs/INTEGRATIONS.md.
# ============================================================================

# --- Общее ----------------------------------------------------------------
# development | production
APP_ENV=production
# Публичный адрес системы (для CORS и ссылок). На VPS — https://<домен>.
PUBLIC_URL=https://lawyer.futuguru.com

# --- Домен и TLS (Let's Encrypt) ------------------------------------------
# Домен, на который выпускается сертификат (A-запись должна указывать на VPS).
DOMAIN=lawyer.futuguru.com
# E-mail для уведомлений Let's Encrypt об истечении сертификата.
LETSENCRYPT_EMAIL=admin@futuguru.com
# Доп. домены в тот же сертификат (через пробел). У каждого должна быть A-запись
# на этот VPS. Пример (также обходит недельный лимит на набор доменов):
# CERT_EXTRA_DOMAINS=www.lawyer.futuguru.com
CERT_EXTRA_DOMAINS=

# --- Быстрое развёртывание из готовых образов (GHCR) ----------------------
# Префикс образов в реестре. Используется docker-compose.registry.yml, чтобы
# скачивать готовые образы вместо сборки на сервере (см. docs/DEPLOYMENT.md).
IMAGE_PREFIX=ghcr.io/andrrrrey

# --- База данных (PostgreSQL 16) ------------------------------------------
POSTGRES_USER=lawyer
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=lawyer
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Аутентификация (единый вход, Этап 1) ---------------------------------
# Логин/пароль администратора для входа в дашборд и админ-панель.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password
# Секрет подписи сессии. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_TTL_MINUTES=720

# --- Источник данных ------------------------------------------------------
# mock — демо-данные прототипа (по умолчанию для проверки интерфейса)
# real — боевые интеграции (после заполнения доступов ниже)
DATA_SOURCE=mock

# ============================================================================
#  ИНТЕГРАЦИИ. Заполняются при DATA_SOURCE=real. Как получить — см.
#  docs/INTEGRATIONS.md. Пункты с «!» оформляются заранее (не мгновенно).
# ============================================================================

# --- Битрикс24: два технических источника CRM -----------------------------
BITRIX_BOX_WEBHOOK_URL=
BITRIX_BOX_INBOUND_TOKEN=
BITRIX_CLOUD_WEBHOOK_URL=
BITRIX_CLOUD_INBOUND_TOKEN=

# --- Яндекс Директ + Метрика: по аккаунту на каждое юрлицо ----------------
YANDEX_UO_OAUTH_TOKEN=
YANDEX_UO_DIRECT_LOGIN=
YANDEX_UO_METRIKA_COUNTER_ID=
YANDEX_CSV_OAUTH_TOKEN=
YANDEX_CSV_DIRECT_LOGIN=
YANDEX_CSV_METRIKA_COUNTER_ID=
YANDEX_URPASE_OAUTH_TOKEN=
YANDEX_URPASE_DIRECT_LOGIN=
YANDEX_URPASE_METRIKA_COUNTER_ID=

# --- 1С:УНФ ---------------------------------------------------------------
# HTTP endpoint и Basic Authentication согласно ТЗ. Реальные значения не
# коммитятся; их также можно задать через страницу «Интеграции».
ONEC_ENDPOINT=
ONEC_USERNAME=
ONEC_PASSWORD=

# --- AI-слой (LLM через облачный API) -------------------------------------
# Модель и юрисдикция согласуются сторонами (раздел 7 ТЗ).
# OpenAI-совместимый эндпоинт: base URL, ключ, идентификатор модели.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
